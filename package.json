{
  "name": "mianshi",
  "private": true,
  "version": "0.2.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "android:debug": "node scripts/build-android-debug.mjs",
    "android:debug:arm64": "npm run android:debug -- --target aarch64",
    "android:release": "node scripts/build-android-debug.mjs --release",
    "android:release:arm64": "npm run android:release -- --target aarch64",
    "update:setup": "node scripts/release.mjs setup",
    "release": "node scripts/release.mjs publish",
    "security:audit": "npm audit --registry=https://registry.npmjs.org && cargo audit --file src-tauri/Cargo.lock",
    "pdf:sample": "tsx scripts/create-pdf-sample.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@phosphor-icons/react": "^2.1.10",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "pdf-lib": "^1.17.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "tsx": "^4.23.12",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.10"
  }
}
