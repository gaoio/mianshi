{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-save",
    "fs:allow-write-file",
    "allow-open-source-window",
    "allow-test-model-connection",
    "allow-generate-resume",
    "allow-analyze-interview-experience",
    "allow-cancel-interview-generation",
    "allow-get-app-update-status",
    "allow-check-app-update",
    "allow-install-app-update",
    "allow-open-app-release-page",
    "allow-open-android-update"
  ]
}
